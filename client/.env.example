# Client Environment Variables
# Copy this file to .env and fill in your values

# API URL - Backend server URL
# For local development with separate backend:
VITE_API_BASE_URL=http://localhost:3001/api

# For Vercel deployment (frontend + backend together):
# Leave empty or use /api - it will use relative path
# VITE_API_BASE_URL=/api

# For production with separate backend:
# VITE_API_BASE_URL=https://your-backend-domain.com/api

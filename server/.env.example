# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas (Free Tier - 512MB)
# Sign up: https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/learnstream?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# YouTube Data API v3 (Free - 10,000 units/day)
# Get key: https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key

# Google Gemini API (Free - 15 RPM, 1M tokens/month)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# AssemblyAI (Free - 100 hours transcription)
# Sign up: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
